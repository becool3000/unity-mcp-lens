<Window x:Class="UnityMcpLens.CommandCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unity MCP Lens Command Center"
        Width="1120"
        Height="760"
        MinWidth="920"
        MinHeight="620"
        Background="#F8FAFC">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F172A" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Unity MCP Lens Command Center"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ContextText"
                               Foreground="#CBD5E1"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" Click="RefreshButton_Click" ToolTip="Reload status files, settings, and install metadata." />
                    <Button Content="Open Server Folder" Click="OpenServerFolder_Click" ToolTip="Open the installed Lens server directory." />
                    <Button Content="Open Status Folder" Click="OpenStatusFolder_Click" ToolTip="Open the bridge status directory." />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="18">
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="Unity Editor" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="UnityPidText" FontSize="14" />
                                    <TextBlock x:Name="UnityPidHint" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="Bridge Status" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="BridgeSummaryText" FontSize="14" />
                                    <TextBlock Text="These are file-based facts; this screen does not call into Unity." Style="{StaticResource HintText}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Installed Server" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="ServerVersionText" FontSize="14" />
                                    <TextBlock x:Name="CommandCenterUpdateText" Style="{StaticResource HintText}" Margin="0,6,0,8" />
                                    <Button Content="Refresh Server" Click="RefreshServerButton_Click" ToolTip="Refresh the installed MCP host binary from the package source or bundled prebuilt." />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Bridge Candidates" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Freshness is based on file-backed bridge and editor-health heartbeats plus editor PID liveness." Style="{StaticResource HintText}" Margin="0,0,0,8" />
                                <ListView x:Name="StatusList" MinHeight="240">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Health" DisplayMemberBinding="{Binding HealthDisplay}" Width="220" />
                                            <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="110" />
                                            <GridViewColumn Header="Project Match" DisplayMemberBinding="{Binding ProjectMatch}" Width="100" />
                                            <GridViewColumn Header="Heartbeat" DisplayMemberBinding="{Binding HeartbeatAgeDisplay}" Width="100" />
                                            <GridViewColumn Header="Editor PID" DisplayMemberBinding="{Binding EditorPidDisplay}" Width="140" />
                                            <GridViewColumn Header="Unity State" DisplayMemberBinding="{Binding UnityStateDisplay}" Width="180" />
                                            <GridViewColumn Header="Scene" DisplayMemberBinding="{Binding ActiveSceneDisplay}" Width="160" />
                                            <GridViewColumn Header="Tools" DisplayMemberBinding="{Binding ToolCount}" Width="70" />
                                            <GridViewColumn Header="Project" DisplayMemberBinding="{Binding ProjectRoot}" Width="360" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16" MaxWidth="780">
                        <TextBlock Text="Project Settings" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="These settings are saved to ProjectSettings/Packages/com.becool3000.unity-mcp-lens/Settings.json. Unity reloads them from disk and keeps the direct bridge policy normalized for Codex." Style="{StaticResource HintText}" Margin="0,0,0,12" />

                        <CheckBox x:Name="BridgeEnabledCheckBox" Content="Bridge enabled" Margin="0,4" ToolTip="Controls whether Unity MCP Lens should auto-start the editor bridge." />
                        <CheckBox x:Name="BatchModeEnabledCheckBox" Content="Batch mode enabled" Margin="0,4" />
                        <CheckBox x:Name="AutoApproveBatchCheckBox" Content="Auto-approve in batch mode" Margin="0,4" />
                        <CheckBox x:Name="LegacyRelayCheckBox" Content="Enable legacy Unity relay compatibility" Margin="0,4" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                            <TextBlock Text="Validation level" Width="160" VerticalAlignment="Center" />
                            <ComboBox x:Name="ValidationLevelComboBox" Width="220">
                                <ComboBoxItem Content="basic" />
                                <ComboBoxItem Content="standard" />
                                <ComboBoxItem Content="comprehensive" />
                                <ComboBoxItem Content="strict" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                            <TextBlock Text="Max direct connections" Width="160" VerticalAlignment="Center" />
                            <TextBox x:Name="MaxDirectConnectionsTextBox" Width="100" ToolTip="-1 means unlimited." />
                        </StackPanel>

                        <TextBlock Text="Tool Overrides" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
                        <TextBlock Text="Enter one tool name per line or separate names with commas." Style="{StaticResource HintText}" Margin="0,0,0,8" />
                        <TextBlock Text="Enabled overrides" FontWeight="SemiBold" />
                        <TextBox x:Name="EnabledOverridesTextBox" AcceptsReturn="True" Height="96" VerticalScrollBarVisibility="Auto" Margin="0,4,0,10" />
                        <TextBlock Text="Disabled overrides" FontWeight="SemiBold" />
                        <TextBox x:Name="DisabledOverridesTextBox" AcceptsReturn="True" Height="96" VerticalScrollBarVisibility="Auto" Margin="0,4,0,14" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save Settings" Click="SaveSettingsButton_Click" ToolTip="Atomically write the shared project settings file." />
                            <Button Content="Reload" Click="ReloadSettingsButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Paths">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Resolved Paths" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="ProjectRootText" Margin="0,4" />
                        <TextBlock x:Name="PackageRootText" Margin="0,4" />
                        <TextBlock x:Name="StatusDirectoryText" Margin="0,4" />
                        <TextBlock x:Name="SettingsPathText" Margin="0,4" />
                        <TextBlock x:Name="InstalledServerPathText" Margin="0,4" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
